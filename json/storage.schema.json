{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secretary:storage:v1",
  "$defs": {
    "Frame": {
      "type": "object",
      "properties": {
        "payload_b64": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "sha256": {
          "$ref": "urn:secretary:contracts:v1#/$defs/Digest"
        }
      },
      "required": [
        "payload_b64",
        "sha256"
      ],
      "additionalProperties": false
    },
    "SnapshotEntry": {
      "type": "object",
      "properties": {
        "object_type": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "$ref": "urn:secretary:contracts:v1#/$defs/ID"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "snapshot": {
          "$ref": "urn:secretary:contracts:v1#/$defs/ObjectRef"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "revision",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "SnapshotManifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "generation_id": {
          "$ref": "urn:secretary:contracts:v1#/$defs/ID"
        },
        "journal_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "journal_digest": {
          "$ref": "urn:secretary:contracts:v1#/$defs/Digest"
        },
        "owner_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SnapshotEntry"
          }
        }
      },
      "required": [
        "schema_version",
        "generation_id",
        "journal_sequence",
        "journal_digest",
        "owner_epoch",
        "objects"
      ],
      "additionalProperties": false
    },
    "WorkspaceManifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "$ref": "urn:secretary:contracts:v1#/$defs/ID"
        },
        "created_at": {
          "$ref": "urn:secretary:contracts:v1#/$defs/Time"
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "created_at"
      ],
      "additionalProperties": false
    },
    "ExecutionManifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "$ref": "urn:secretary:contracts:v1#/$defs/ID"
        },
        "execution_id": {
          "$ref": "urn:secretary:contracts:v1#/$defs/ID"
        },
        "checkpoint_id": {
          "anyOf": [
            {
              "$ref": "urn:secretary:contracts:v1#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_id": {
          "anyOf": [
            {
              "$ref": "urn:secretary:contracts:v1#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "urn:secretary:contracts:v1#/$defs/ObjectRef"
          }
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "execution_id",
        "checkpoint_id",
        "result_id",
        "objects"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Frame"
    },
    {
      "$ref": "#/$defs/SnapshotManifest"
    },
    {
      "$ref": "#/$defs/WorkspaceManifest"
    },
    {
      "$ref": "#/$defs/ExecutionManifest"
    }
  ]
}
