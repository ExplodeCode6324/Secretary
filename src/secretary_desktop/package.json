{
  "name": "secretary-desktop-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "tauri": "tauri",
    "test:native": "wdio run ./wdio.conf.ts",
    "evidence": "node scripts/evidence.mjs",
    "measure": "python3 scripts/measure.py",
    "build:native": "VITE_NATIVE_TEST=1 CARGO_TARGET_DIR=target/native-test tauri build --features native-test --config src-tauri/tauri.native-test.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "markdown-it": "15.0.3",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/markdown-it": "14.1.2",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.5.0",
    "@wdio/tauri-service": "1.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.4.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "webdriverio": "9.32.0"
  }
}
