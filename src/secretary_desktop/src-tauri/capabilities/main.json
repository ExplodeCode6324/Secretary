{
  "identifier": "main",
  "description": "Local desktop window: controlled Core bridge and study zoom.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:webview:allow-set-webview-zoom",
    "allow-study-mode",
    "allow-phaseui-view",
    "allow-study-ready",
    "allow-study-metrics",
    "allow-bridge-profiles",
    "allow-bridge-transient",
    "allow-bridge-connect",
    "allow-bridge-draft",
    "allow-bridge-submit",
    "allow-bridge-query",
    "allow-bridge-subscribe",
    "allow-bridge-anchor",
    "allow-bridge-stop",
    "allow-bridge-download"
  ]
}
