{
  "schema_version": 1,
  "machines": {
    "Input": {
      "owner": "host",
      "initial": "ACCEPTED",
      "terminal": [
        "HANDLED",
        "WITHDRAWN"
      ],
      "states": [
        "ACCEPTED",
        "CLAIMED",
        "HANDLED",
        "WITHDRAWN"
      ],
      "transitions": [
        {
          "id": "Input-01",
          "from": "ACCEPTED",
          "event": "claim",
          "to": "CLAIMED",
          "guard": "single_loop",
          "commit": "保存 loop_id"
        },
        {
          "id": "Input-02",
          "from": "CLAIMED",
          "event": "processed",
          "to": "HANDLED",
          "guard": "response_and_effects_durable",
          "commit": "提交本批输入处理回执"
        },
        {
          "id": "Input-03",
          "from": "CLAIMED",
          "event": "recover",
          "to": "CLAIMED",
          "guard": "same_loop_checkpoint",
          "commit": "续接同一 loop，禁止重新从头执行工具"
        },
        {
          "id": "Input-04",
          "from": "ACCEPTED",
          "event": "withdraw",
          "to": "WITHDRAWN",
          "guard": "attachment_owner_quiescent_no_output_or_effects",
          "commit": "原子提交输入撤回及必要的Session/Context"
        },
        {
          "id": "Input-05",
          "from": "CLAIMED",
          "event": "withdraw",
          "to": "WITHDRAWN",
          "guard": "attachment_owner_quiescent_no_output_or_effects",
          "commit": "原子提交输入撤回及必要的Session/Context"
        }
      ]
    },
    "Execution": {
      "owner": "scheduler",
      "initial": "CREATED",
      "terminal": [
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "EXPIRED"
      ],
      "states": [
        "CREATED",
        "WAIT_PRECONDITION",
        "READY",
        "DISPATCHING",
        "RUNNING",
        "WAIT_DECISION",
        "WAIT_AUTH",
        "CANCEL_REQUESTED",
        "RESULT_UNKNOWN",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "EXPIRED"
      ],
      "transitions": [
        {
          "id": "Execution-01",
          "from": "CREATED",
          "event": "check",
          "to": "WAIT_PRECONDITION",
          "guard": "trigger_due",
          "commit": "保存前提检查"
        },
        {
          "id": "Execution-02",
          "from": "WAIT_PRECONDITION",
          "event": "ready",
          "to": "READY",
          "guard": "preconditions_met",
          "commit": "清除可恢复等待"
        },
        {
          "id": "Execution-03",
          "from": "READY",
          "event": "dispatch",
          "to": "DISPATCHING",
          "guard": "enabled_revision_and_no_overlap",
          "commit": "保存 Dispatch 与 attempt_id"
        },
        {
          "id": "Execution-04",
          "from": "DISPATCHING",
          "event": "worker_started",
          "to": "RUNNING",
          "guard": "matching_epoch_attempt",
          "commit": "关联 worker"
        },
        {
          "id": "Execution-05",
          "from": "DISPATCHING",
          "event": "spawn_failed",
          "to": "FAILED",
          "guard": "definite_not_started",
          "commit": "保存失败结果"
        },
        {
          "id": "Execution-06",
          "from": "RUNNING",
          "event": "needs_decision",
          "to": "WAIT_DECISION",
          "guard": "materials_saved",
          "commit": "持有 DecisionRequest"
        },
        {
          "id": "Execution-07",
          "from": "WAIT_DECISION",
          "event": "decided",
          "to": "READY",
          "guard": "valid_decision_and_conditions",
          "commit": "保存普通决定"
        },
        {
          "id": "Execution-08",
          "from": "RUNNING",
          "event": "needs_auth",
          "to": "WAIT_AUTH",
          "guard": "operation_prepared",
          "commit": "持有 AuthorizationRequest"
        },
        {
          "id": "Execution-09",
          "from": "WAIT_AUTH",
          "event": "authorized",
          "to": "READY",
          "guard": "grant_current",
          "commit": "待执行操作仍须最终 gate"
        },
        {
          "id": "Execution-10",
          "from": "WAIT_AUTH",
          "event": "refused",
          "to": "FAILED",
          "guard": "task_cannot_continue",
          "commit": "保存拒绝结果"
        },
        {
          "id": "Execution-11",
          "from": "RUNNING",
          "event": "success",
          "to": "SUCCEEDED",
          "guard": "result_and_evidence_saved",
          "commit": "结果已可查再创建反馈"
        },
        {
          "id": "Execution-12",
          "from": "RUNNING",
          "event": "failure",
          "to": "FAILED",
          "guard": "known_failed",
          "commit": "保存已知影响"
        },
        {
          "id": "Execution-13",
          "from": "RUNNING",
          "event": "uncertain",
          "to": "RESULT_UNKNOWN",
          "guard": "missing_effect_result",
          "commit": "停止相关操作并反馈"
        },
        {
          "id": "Execution-14",
          "from": "DISPATCHING",
          "event": "lost",
          "to": "RESULT_UNKNOWN",
          "guard": "may_have_started",
          "commit": "先查 worker/receipt"
        },
        {
          "id": "Execution-15",
          "from": "RESULT_UNKNOWN",
          "event": "verified_success",
          "to": "SUCCEEDED",
          "guard": "new_evidence",
          "commit": "记录核验依据"
        },
        {
          "id": "Execution-16",
          "from": "RESULT_UNKNOWN",
          "event": "verified_failure",
          "to": "FAILED",
          "guard": "new_evidence",
          "commit": "不自动重试"
        },
        {
          "id": "Execution-18",
          "from": "CANCEL_REQUESTED",
          "event": "stopped",
          "to": "CANCELLED",
          "guard": "stop_and_effects_known",
          "commit": "保存停止证据"
        },
        {
          "id": "Execution-19",
          "from": "CANCEL_REQUESTED",
          "event": "uncertain",
          "to": "RESULT_UNKNOWN",
          "guard": "effects_unknown",
          "commit": "保留取消意图"
        },
        {
          "id": "Execution-20",
          "from": "CANCEL_REQUESTED",
          "event": "completed_before_cancel",
          "to": "SUCCEEDED",
          "guard": "completion_proven",
          "commit": "报告取消未阻止完成"
        },
        {
          "id": "Execution-21",
          "from": "CREATED",
          "event": "cancel",
          "to": "CANCELLED",
          "guard": "no_inflight_effect",
          "commit": "未开始的相关操作取消"
        },
        {
          "id": "Execution-22",
          "from": "CREATED",
          "event": "deadline",
          "to": "EXPIRED",
          "guard": "deadline_elapsed_and_no_inflight",
          "commit": "到期结束；无期限不自行过期"
        },
        {
          "id": "Execution-23",
          "from": "WAIT_PRECONDITION",
          "event": "cancel",
          "to": "CANCELLED",
          "guard": "no_inflight_effect",
          "commit": "未开始的相关操作取消"
        },
        {
          "id": "Execution-24",
          "from": "WAIT_PRECONDITION",
          "event": "deadline",
          "to": "EXPIRED",
          "guard": "deadline_elapsed_and_no_inflight",
          "commit": "到期结束；无期限不自行过期"
        },
        {
          "id": "Execution-25",
          "from": "READY",
          "event": "cancel",
          "to": "CANCELLED",
          "guard": "no_inflight_effect",
          "commit": "未开始的相关操作取消"
        },
        {
          "id": "Execution-26",
          "from": "READY",
          "event": "deadline",
          "to": "EXPIRED",
          "guard": "deadline_elapsed_and_no_inflight",
          "commit": "到期结束；无期限不自行过期"
        },
        {
          "id": "Execution-27",
          "from": "WAIT_DECISION",
          "event": "cancel",
          "to": "CANCELLED",
          "guard": "no_inflight_effect",
          "commit": "未开始的相关操作取消"
        },
        {
          "id": "Execution-28",
          "from": "WAIT_DECISION",
          "event": "deadline",
          "to": "EXPIRED",
          "guard": "deadline_elapsed_and_no_inflight",
          "commit": "到期结束；无期限不自行过期"
        },
        {
          "id": "Execution-29",
          "from": "WAIT_AUTH",
          "event": "cancel",
          "to": "CANCELLED",
          "guard": "no_inflight_effect",
          "commit": "未开始的相关操作取消"
        },
        {
          "id": "Execution-30",
          "from": "WAIT_AUTH",
          "event": "deadline",
          "to": "EXPIRED",
          "guard": "deadline_elapsed_and_no_inflight",
          "commit": "到期结束；无期限不自行过期"
        },
        {
          "id": "Execution-31",
          "from": "RUNNING",
          "event": "cancel",
          "to": "CANCEL_REQUESTED",
          "guard": "request_valid",
          "commit": "只记录请求；停止须回执"
        },
        {
          "id": "Execution-32",
          "from": "DISPATCHING",
          "event": "cancel",
          "to": "CANCEL_REQUESTED",
          "guard": "request_valid",
          "commit": "只记录请求；停止须回执"
        },
        {
          "id": "Execution-33",
          "from": "READY",
          "event": "needs_auth",
          "to": "WAIT_AUTH",
          "guard": "operation_prepared",
          "commit": "程序启动先创建受控 program.run 请求，不先启动程序"
        },
        {
          "id": "Execution-34",
          "from": "WAIT_AUTH",
          "event": "needs_decision",
          "to": "WAIT_DECISION",
          "guard": "materials_saved",
          "commit": "授权拒绝后请求普通方案选择，不能把选择变批准"
        },
        {
          "id": "Execution-35",
          "from": "RUNNING",
          "event": "deadline",
          "to": "CANCEL_REQUESTED",
          "guard": "deadline_elapsed",
          "commit": "保存到期原因，等待实际停止"
        },
        {
          "id": "Execution-36",
          "from": "DISPATCHING",
          "event": "deadline",
          "to": "CANCEL_REQUESTED",
          "guard": "deadline_elapsed",
          "commit": "先核实分派，不把超时当未发生"
        },
        {
          "id": "Execution-resolved_stopped",
          "event": "resolved_stopped",
          "from": "RESULT_UNKNOWN",
          "to": "FAILED",
          "guard": "no_unknown_and_group_stopped",
          "commit": "中断执行收束；裁定不代表任务成功"
        },
        {
          "id": "Execution-model_recovery",
          "event": "model_recovery",
          "from": "RUNNING",
          "to": "READY",
          "guard": "durable_model_request_and_no_unknown_effect",
          "commit": "恢复同一请求，不刷新执行包"
        },
        {
          "id": "Execution-scope-slot",
          "from": "READY",
          "event": "scope_unavailable",
          "to": "WAIT_PRECONDITION",
          "guard": "scope_busy_archived_or_root_conflict",
          "commit": "保存明确等待原因，不重绑目录"
        },
        {
          "id": "Execution-resume_authorized-WAIT_AUTH",
          "from": "WAIT_AUTH",
          "event": "resume_authorized",
          "to": "DISPATCHING"
        },
        {
          "id": "Execution-scope_unavailable-WAIT_AUTH",
          "from": "WAIT_AUTH",
          "event": "scope_unavailable",
          "to": "WAIT_PRECONDITION"
        },
        {
          "id": "Execution-resume_authorized_or_model-DISPATCHING",
          "from": "DISPATCHING",
          "event": "resume_authorized_or_model",
          "to": "READY"
        },
        {
          "id": "Execution-program_authorization-DISPATCHING",
          "from": "DISPATCHING",
          "event": "program_authorization",
          "to": "WAIT_AUTH"
        },
        {
          "id": "Execution-known_failure-CANCEL_REQUESTED",
          "from": "CANCEL_REQUESTED",
          "event": "known_failure",
          "to": "FAILED"
        },
        {
          "id": "Execution-cancel_complete-RUNNING",
          "from": "RUNNING",
          "event": "cancel_complete",
          "to": "CANCELLED"
        },
        {
          "id": "Execution-legacy-auth-unknown",
          "from": "WAIT_AUTH",
          "event": "legacy_authorized_effect_unknown",
          "to": "RESULT_UNKNOWN",
          "guard": "legacy_resume_before_dispatch",
          "commit": "兼容 9623095 scheduler.execute 的授权恢复日志；当前执行先进入 DISPATCHING"
        },
        {
          "id": "Execution-cancelled-auth-resume",
          "from": "CANCEL_REQUESTED",
          "event": "authorized_effect_completed",
          "to": "READY",
          "guard": "resumeAuth_effect_completed_after_cancel",
          "commit": "保留取消标记，随后按原 execute 流程结束取消"
        }
      ]
    },
    "Operation": {
      "owner": "gateway",
      "initial": "PREPARED",
      "terminal": [
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "states": [
        "PREPARED",
        "WAIT_AUTH",
        "AUTHORIZED",
        "DISPATCHED",
        "SUCCEEDED",
        "FAILED",
        "RESULT_UNKNOWN",
        "CANCELLED"
      ],
      "transitions": [
        {
          "id": "Operation-01",
          "from": "PREPARED",
          "event": "covered",
          "to": "AUTHORIZED",
          "guard": "rule_matches",
          "commit": "保存规则版本与范围"
        },
        {
          "id": "Operation-02",
          "from": "PREPARED",
          "event": "request",
          "to": "WAIT_AUTH",
          "guard": "valid_not_covered",
          "commit": "生成授权请求"
        },
        {
          "id": "Operation-03",
          "from": "WAIT_AUTH",
          "event": "approve",
          "to": "AUTHORIZED",
          "guard": "master_ui_valid",
          "commit": "绑定 grant"
        },
        {
          "id": "Operation-04",
          "from": "WAIT_AUTH",
          "event": "deny",
          "to": "CANCELLED",
          "guard": "master_reject_or_expire",
          "commit": "无执行"
        },
        {
          "id": "Operation-05",
          "from": "AUTHORIZED",
          "event": "execute",
          "to": "DISPATCHED",
          "guard": "final_gate",
          "commit": "一次提交 consume grant + dispatch intent"
        },
        {
          "id": "Operation-06",
          "from": "AUTHORIZED",
          "event": "stale",
          "to": "WAIT_AUTH",
          "guard": "grant_or_target_changed",
          "commit": "原 grant 不再适用"
        },
        {
          "id": "Operation-07",
          "from": "DISPATCHED",
          "event": "success",
          "to": "SUCCEEDED",
          "guard": "durable_receipt",
          "commit": "结果与证据留存"
        },
        {
          "id": "Operation-08",
          "from": "DISPATCHED",
          "event": "failure",
          "to": "FAILED",
          "guard": "known_effects",
          "commit": "保存实际影响"
        },
        {
          "id": "Operation-09",
          "from": "DISPATCHED",
          "event": "lost",
          "to": "RESULT_UNKNOWN",
          "guard": "outcome_unknown",
          "commit": "禁止重做"
        },
        {
          "id": "Operation-10",
          "from": "RESULT_UNKNOWN",
          "event": "verify_success",
          "to": "SUCCEEDED",
          "guard": "evidence",
          "commit": "只补证据"
        },
        {
          "id": "Operation-11",
          "from": "RESULT_UNKNOWN",
          "event": "verify_failure",
          "to": "FAILED",
          "guard": "evidence",
          "commit": "新重试须新操作且符合安全规则"
        },
        {
          "id": "Operation-12",
          "from": "PREPARED",
          "event": "cancel",
          "to": "CANCELLED",
          "guard": "no_inflight_effect",
          "commit": "未分派；撤下批准请求或使批准不可消费"
        },
        {
          "id": "Operation-13",
          "from": "WAIT_AUTH",
          "event": "cancel",
          "to": "CANCELLED",
          "guard": "no_inflight_effect",
          "commit": "未分派；撤下批准请求或使批准不可消费"
        },
        {
          "id": "Operation-14",
          "from": "AUTHORIZED",
          "event": "cancel",
          "to": "CANCELLED",
          "guard": "no_inflight_effect",
          "commit": "未分派；撤下批准请求或使批准不可消费"
        },
        {
          "id": "Operation-owner_applied",
          "event": "owner_applied",
          "from": "RESULT_UNKNOWN",
          "to": "SUCCEEDED",
          "guard": "owner_revision_matches",
          "commit": "记录 Master 裁定与原回执"
        },
        {
          "id": "Operation-owner_closed",
          "event": "owner_closed",
          "from": "RESULT_UNKNOWN",
          "to": "FAILED",
          "guard": "owner_revision_matches",
          "commit": "NOT_APPLIED/PARTIAL/UNVERIFIED；保留原回执"
        },
        {
          "id": "Operation-resume_world_transaction-RESULT_UNKNOWN",
          "from": "RESULT_UNKNOWN",
          "event": "resume_world_transaction",
          "to": "DISPATCHED"
        }
      ]
    },
    "Authorization": {
      "owner": "scheduler.authorization",
      "initial": "PENDING",
      "terminal": [
        "REJECTED",
        "REVOKED",
        "EXPIRED",
        "CONSUMED"
      ],
      "states": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "REVOKED",
        "EXPIRED",
        "CONSUMED"
      ],
      "transitions": [
        {
          "id": "Authorization-01",
          "from": "PENDING",
          "event": "approve",
          "to": "APPROVED",
          "guard": "master_ui_and_scope_match",
          "commit": "持久化批准"
        },
        {
          "id": "Authorization-02",
          "from": "PENDING",
          "event": "reject",
          "to": "REJECTED",
          "guard": "master_ui",
          "commit": "持久化拒绝"
        },
        {
          "id": "Authorization-03",
          "from": "PENDING",
          "event": "expire",
          "to": "EXPIRED",
          "guard": "deadline_elapsed",
          "commit": "撤下有效请求"
        },
        {
          "id": "Authorization-04",
          "from": "APPROVED",
          "event": "revoke",
          "to": "REVOKED",
          "guard": "master_ui",
          "commit": "阻止未分派操作"
        },
        {
          "id": "Authorization-05",
          "from": "APPROVED",
          "event": "expire",
          "to": "EXPIRED",
          "guard": "deadline_elapsed",
          "commit": "禁止消费"
        },
        {
          "id": "Authorization-06",
          "from": "APPROVED",
          "event": "consume",
          "to": "CONSUMED",
          "guard": "final_gate",
          "commit": "与 Operation.DISPATCHED 同事务"
        },
        {
          "id": "Authorization-07",
          "from": "PENDING",
          "event": "withdraw",
          "to": "REVOKED",
          "guard": "scope_changed",
          "commit": "操作取消或对象改变，请求作废"
        }
      ]
    },
    "AttachmentImport": {
      "owner": "attachment importer",
      "initial": "PENDING",
      "terminal": [
        "READY",
        "FAILED"
      ],
      "states": [
        "PENDING",
        "READY",
        "FAILED"
      ],
      "transitions": [
        {
          "id": "AttachmentImport-01",
          "from": "PENDING",
          "event": "validated",
          "to": "READY",
          "guard": "bytes_durable",
          "commit": "Attachment与ApiCommand完成同帧"
        },
        {
          "id": "AttachmentImport-02",
          "from": "PENDING",
          "event": "definite_failure",
          "to": "FAILED",
          "guard": "known_failure",
          "commit": "失败回执与保留或释放容量同帧"
        }
      ]
    }
  }
}
