        },
        {
          "id": "Program-04",
          "from": "ENABLED",
          "event": "update",
          "to": "ENABLED",
          "guard": "human_validated",
          "commit": "新 revision；分派前再检查"
        },
        {
          "id": "Program-05",
          "from": "DISABLED",
          "event": "update",
          "to": "DISABLED",
          "guard": "human_validated",
          "commit": "新 revision 保持禁用"
        },
        {
          "id": "Program-06",
          "from": "REGISTERED",
          "event": "update",
          "to": "REGISTERED",
          "guard": "human_validated",
          "commit": "人工修订未启用的登记版本"
        }
      ]
    }
  }
