{
  "name": "secretary-pi",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 \"test_case/offline/**/*.test.ts\"",
    "test:issue5": "tsx --test test_case/offline/issue5/*.test.ts",
    "start": "tsx src/pi_secretary/src/core-cli.ts start",
    "verify": "npm run check && npm run docs:check && npm test",
    "format:check": "prettier --check \"src/pi_secretary/src/**/*.ts\" \"test_case/offline/runtime/**/*.ts\"",
    "start:live": "tsx src/pi_secretary/scripts/start-live.ts",
    "test:live": "tsx test_case/online/test-live.ts",
    "test:review": "tsx --test \"test_case/offline/audit/*.test.ts\"",
    "test:instructions:live": "tsx test_case/online/test-instructions-live.ts",
    "stop": "tsx src/pi_secretary/src/core-cli.ts stop",
    "types:generate": "node src/pi_secretary/scripts/generate-types.mjs",
    "docs:generate": "python3 src/pi_secretary/scripts/generate-docs.py && npm run docs:localize",
    "docs:check": "python3 src/pi_secretary/scripts/check-docs.py && npm run docs:localize:check",
    "test:task-reuse:live": "tsx test_case/online/test-task-reuse-live.ts",
    "test:task-reuse": "tsx --test test_case/offline/runtime/task-reuse.test.ts",
    "test:continuity:live": "tsx test_case/online/test-continuity-astra-live.ts",
    "core": "tsx src/pi_secretary/src/core-cli.ts",
    "start:core": "tsx src/pi_secretary/src/core-cli.ts start",
    "test:api": "tsx --test test_case/offline/issue8/*.test.ts",
    "api:generate": "node src/pi_secretary/scripts/generate-api.mjs",
    "test:db:clean": "tsx test_case/offline/helpers/clean-postgres.ts",
    "docs:localize": "python3 src/pi_secretary/scripts/localize-docs.py",
    "docs:localize:check": "python3 src/pi_secretary/scripts/localize-docs.py --check",
    "tui:g0": "tsx src/pi_secretary/scripts/issue82-g0.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pg": "8.23.0",
    "sharp": "0.35.5",
    "stream-json": "3.7.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.15.6",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
