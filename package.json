{
  "name": "secretary-pi",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test_case/offline/runtime/*.test.ts",
    "start": "tsx src/pi_secretary/src/client-tui.ts",
    "verify": "npm run check && npm test",
    "format:check": "prettier --check \"src/pi_secretary/src/**/*.ts\" \"test_case/offline/runtime/**/*.ts\"",
    "start:live": "tsx src/pi_secretary/scripts/start-live.ts",
    "test:live": "tsx test_case/online/test-live.ts",
    "test:review": "tsx --test --test-skip-pattern='AUD14' test_case/offline/audit/new.test.ts test_case/offline/audit/extra.test.ts test_case/offline/audit/final.test.ts test_case/offline/audit/legacy.test.ts",
    "start:web": "tsx src/pi_secretary/src/web.ts",
    "start:web:live": "tsx src/pi_secretary/scripts/start-live.ts --web",
    "test:instructions:live": "tsx test_case/online/test-instructions-live.ts",
    "stop": "tsx src/pi_secretary/src/stop-ui.ts",
    "types:generate": "node src/pi_secretary/scripts/generate-types.mjs",
    "docs:generate": "python3 src/pi_secretary/scripts/generate-docs.py",
    "docs:check": "python3 src/pi_secretary/scripts/check-docs.py"
  },
  "dependencies": {
    "@earendil-works/chord": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pg": "8.23.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.15.6",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
