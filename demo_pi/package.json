{
  "name": "secretary-pi-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test pi_secretary/test/*.test.ts",
    "start": "tsx pi_secretary/src/client-tui.ts",
    "verify": "npm run check && npm test",
    "format:check": "prettier --check \"pi_secretary/src/**/*.ts\" \"pi_secretary/test/**/*.ts\"",
    "start:live": "tsx pi_secretary/scripts/start-live.ts",
    "test:live": "tsx pi_secretary/scripts/test-live.ts",
    "test:review": "tsx --test --test-skip-pattern='AUD14' pi_secretary/audit/new.test.ts pi_secretary/audit/extra.test.ts pi_secretary/audit/final.test.ts pi_secretary/audit/legacy.test.ts",
    "start:web": "tsx pi_secretary/src/web.ts",
    "start:web:live": "tsx pi_secretary/scripts/start-live.ts --web"
  },
  "dependencies": {
    "@earendil-works/chord": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pg": "8.23.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.15.6",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
