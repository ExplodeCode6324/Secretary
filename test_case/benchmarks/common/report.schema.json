{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Secretary test report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "track",
    "source",
    "configuration",
    "started_at",
    "finished_at",
    "cases",
    "evidence_classes",
    "metrics",
    "limitations",
    "first_failure",
    "machine"
  ],
  "properties": {
    "source": {
      "type": "object"
    },
    "configuration": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "machine": {
      "type": "object"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "secretary-test-report-v1"
    },
    "track": {
      "enum": [
        "correctness",
        "memory"
      ]
    },
    "first_failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_TESTED",
              "BLOCKED",
              "INCOMPLETE",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
